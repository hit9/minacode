msgstr "`{ type = \"web_search_20250305\", name = \"web_search\", max_uses = 5 }`"

#: ../../configuration.md
msgid "Z.AI / BigModel"
msgstr "Z.AI / BigModel"

#: ../../configuration.md
msgid "`{ type = \"web_search\", web_search = { enable = \"True\" } }`"
msgstr "`{ type = \"web_search\", web_search = { enable = \"True\" } }`"

#: ../../configuration.md
msgid "Kimi / Moonshot"
msgstr "Kimi / Moonshot"

#: ../../configuration.md
