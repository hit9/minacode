#, python-brace-format
msgid "`{}`"
msgstr "`{}`"

#: ../../configuration.md
msgid "Extra fields for an OpenAI-compatible request body"
msgstr "添加到 OpenAI-compatible request body 的额外字段"

#: ../../configuration.md
msgid "`builtin_tools`"
msgstr "`builtin_tools`"

#: ../../configuration.md
msgid "`[]`"
msgstr "`[]`"

#: ../../configuration.md
