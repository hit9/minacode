msgstr "`false`"

#: ../../configuration.md
msgid "Start without confirmation prompts"
msgstr "启动时关闭确认提示"

#: ../../configuration.md
msgid "`max_context_tokens`"
msgstr "`max_context_tokens`"

#: ../../configuration.md
msgid "`245760` (240K)"
msgstr "`245760`（240K）"

#: ../../configuration.md
msgid "Total context ceiling used to calculate the automatic-compaction budget"
msgstr "用于计算自动 compaction 预算的 context 总上限"

#: ../../configuration.md
msgid "`max_agent_steps`"
msgstr "`max_agent_steps`"

#: ../../configuration.md
msgid "`200`"
msgstr "`200`"

#: ../../configuration.md
msgid "Maximum tool steps in one turn"
msgstr "单轮任务的最大工具步数"

#: ../../configuration.md
msgid "`shell_timeout`"
msgstr "`shell_timeout`"

#: ../../configuration.md
msgid "`60`"
msgstr "`60`"

#: ../../configuration.md
msgid "Maximum shell-command lifetime, in seconds"
msgstr "shell 命令最大运行秒数"

#: ../../configuration.md
msgid "`bash_wait_timeout`"
msgstr "`bash_wait_timeout`"

#: ../../configuration.md
msgid "`10`"
msgstr "`10`"

#: ../../configuration.md
msgid "Foreground wait before a running command becomes a background job; `0` disables promotion"
msgstr "前台命令转为后台任务前的等待秒数；`0` 表示禁用"

#: ../../configuration.md
msgid "`max_parallel_tools`"
msgstr "`max_parallel_tools`"

#: ../../configuration.md
msgid "`4`"
msgstr "`4`"

#: ../../configuration.md
msgid "Maximum read-only tool calls executed concurrently; `1` disables parallelism"
msgstr "并发执行只读工具的上限；`1` 表示禁用并发"

#: ../../configuration.md
msgid "`session_retention_days`"
msgstr "`session_retention_days`"

#: ../../configuration.md
msgid "`7`"
msgstr "`7`"

#: ../../configuration.md
msgid "Delete inactive saved sessions older than this at startup; `0` keeps them indefinitely"
msgstr "启动时删除超过该天数未使用的 session；`0` 表示永久保留"

#: ../../configuration.md
msgid "`theme`"
msgstr "`theme`"

#: ../../configuration.md
msgid "`auto`"
msgstr "`auto`"

#: ../../configuration.md
msgid "Terminal theme: `auto`, `light`, or `dark`; overridden by `--theme`"
msgstr "终端主题：`auto`、`light` 或 `dark`；`--theme` 可覆盖"

#: ../../configuration.md:43
msgid "Selected tuning values can be changed for the current session with `/set` (Tab completion lists the supported keys). `/yolo` toggles `yolo`."
msgstr "部分配置可以用 `/set` 在当前 session 中修改，按 Tab 可补全支持的 key。`/yolo` 用于切换 `yolo`。"

#: ../../configuration.md:46
msgid "Data location"
msgstr "数据目录"

#: ../../configuration.md:53
msgid "Sessions live under `<data_dir>/projects/<project>/`, one directory per working directory. Each holds that project's session logs and a `latest` pointer, so a resume stays scoped to the project it belongs to. A project directory is removed once its last session expires."
msgstr "Session 保存在 `<data_dir>/projects/<project>/`，每个工作目录对应一个子目录，其中存放该项目的 session 日志和 `latest` 指针，因此恢复操作始终限定在所属项目内。当某个项目的最后一个 session 过期后，对应目录会被一并删除。"

