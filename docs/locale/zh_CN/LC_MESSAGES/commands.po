#: ../../commands.md:119
msgid "Help and exit"
msgstr "帮助与退出"

#: ../../commands.md:121
msgid "**`/help`** — Show the built-in command and tool reference."
msgstr "**`/help`** — 显示内置命令和工具参考。"

#: ../../commands.md:123
msgid ""
"**`/exit`, `/quit`** — Leave minacode. Your session is saved "
"automatically and can be resumed with `-c` or `--resume`."
msgstr "**`/exit`, `/quit`** — 退出 minacode。Session 会自动保存，可使用 `-c` 或 `--resume` 恢复。"
